# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase. The two NEXT_PUBLIC_ values turn on sign-in (Google and anonymous,
# see README); the service-role key lets /api/me and /api/beacon save to the
# database. Leave blank to run without Supabase: progress then stays in the
# browser, the beacon API validates but stores nothing, and the Google button
# explains it isn't set up.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign in-person handshake codes. Use a random string of at
# least 32 characters, for example from: openssl rand -hex 32
HANDSHAKE_SECRET=

# true shortens demo wait times. Set to false in production.
DEMO_MODE=true

# Protects /api/hoods/rebalance (the nightly neighbourhood rebalance in
# vercel.json). Vercel sets this automatically for cron jobs when the variable
# exists; use a random string of at least 16 characters.
CRON_SECRET=
