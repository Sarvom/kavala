# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase. The two NEXT_PUBLIC_ values turn on Google sign-in (see README).
# Leave blank to run without Supabase: the beacon API then validates requests
# but reports that nothing was stored, and the Google button explains it isn't set up.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign in-person handshake codes. Use a random string of at
# least 32 characters, for example from: openssl rand -hex 32
HANDSHAKE_SECRET=

# true shortens demo wait times. Set to false in production.
DEMO_MODE=true
